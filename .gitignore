# Verbose per-run console logs (regenerable; structured CSVs are the evidence)
results/*_console.txt

# Local archive of superseded scripts/results (kept on disk, out of git)
archive/

# Solution incumbents (large binary PKLs, regenerable; consumed by run_validate_adaptive.py)
# Trailing glob also covers experiment-arm dirs from --save-suffix (e.g. _h1a).
results/beta_incumbents/
results/beta_incumbents_*/

# Dual certificates from superseded campaigns (regenerable; not used by any
# reported number). The CURRENT certificates in results/certificates/ are
# tracked deliberately: every reported bound must be re-derivable from a clean
# clone, and excluding them is what made the previous verification claim
# uncheckable by anyone but us.
results/beta_certificates/
results/beta_certificates_*/

# Course material - lecturer's slides, not ours to redistribute
Course Lectures/

# Stray duplicate of a publisher PDF at repo root
/OPS_Riera-Ledesma_Salazar-Gonzalez_2021_COR (1).pdf

